{
  "hosting": {
    "public": "build/jaspr",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/tools/ynac",
        "destination": "https://ynac.skylled.dev/",
        "type": 301
      },
      {
        "source": "/tools/ynac/**",
        "destination": "https://ynac.skylled.dev/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
